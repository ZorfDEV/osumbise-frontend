{
  "compilerOptions": {
    "composite": true,
    // Les fichiers générés par tsc -b vont dans node_modules/.tmp, jamais à
    // côté de vite.config.ts : un vite.config.js serait chargé par Vite à la
    // place du .ts, et les modifications de configuration seraient ignorées.
    "outDir": "./node_modules/.tmp/vite-config",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
